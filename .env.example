# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Webhook configuration (for production / Render)
WEBHOOK_URL="https://your-service.onrender.com"
WEBHOOK_SECRET="your-webhook-secret-token"

# Port (Render sets PORT automatically, defaults to 8080 locally)
PORT=8080

# Gemini API configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
AI_ENABLED=true

# Replay speed in seconds per lap (default 8 for demo, lower for testing)
SECONDS_PER_LAP=8
